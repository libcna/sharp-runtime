#pragma once

#include <string_view>

/**
 * @file SharpRuntime/Version.hpp
 * @brief The Sharp Runtime release a translation unit is compiled against.
 *
 * Generated by cmake/Version.cmake from cmake/templates/Version.hpp.in into
 * `<build>/generated/include/SharpRuntime/Version.hpp`, and published on
 * `SharpRuntime::Headers`, the interface target every component and consumer links
 * transitively -- the same carrier the build already uses for
 * `SHARP_RUNTIME_HAS_NATIVE_INT128`. The version itself is decided in one place only:
 * `project(SHARP_RUNTIME VERSION ...)` plus `SHARP_RUNTIME_VERSION_PRERELEASE` in the root
 * CMakeLists.txt (see docs/releasing.md). Never edit the generated copy in the build tree.
 *
 * This is Sharp Runtime's own product version, deliberately distinct from two numbers it is
 * easy to confuse it with. `System::Version` is the ported .NET *type* for representing a
 * version number and says nothing about this library's release. The .NET API level whose
 * surface this library reimplements is a property of the reference, not of this release, and
 * moves independently of it.
 *
 * The object-like macros exist because a constexpr value cannot be tested by the preprocessor;
 * use them for compile-time feature gating (`#if SHARP_RUNTIME_VERSION_MAJOR >= 1`) and the
 * functions below for everything else.
 *
 * The accessors are spelled `getVersionString()` rather than `getVersionStringProperty()`:
 * CLAUDE.md rule 5's `getXxxProperty()` convention exists to mirror a C# property on a ported
 * type, and this header ports nothing -- it is Sharp Runtime's own release identity, and its
 * shape matches the sibling CNA project's `CNA/Version.hpp`.
 */

/** @brief Major component of the Sharp Runtime release, as a preprocessor-testable integer. */
#define SHARP_RUNTIME_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor component of the Sharp Runtime release, as a preprocessor-testable integer. */
#define SHARP_RUNTIME_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch component of the Sharp Runtime release, as a preprocessor-testable integer. */
#define SHARP_RUNTIME_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Pre-release identifier without its leading '-'; an empty string on a final release. */
#define SHARP_RUNTIME_VERSION_PRERELEASE "@SHARP_RUNTIME_VERSION_PRERELEASE@"

/** @brief The complete release string, e.g. "0.1.0-alpha.1". */
#define SHARP_RUNTIME_VERSION_STRING "@SHARP_RUNTIME_VERSION_STRING@"

namespace SharpRuntime
{
    /**
     * @brief Returns the major component of the Sharp Runtime release being compiled against.
     *
     * @return The Semantic Versioning major component.
     */
    [[nodiscard]] constexpr int getVersionMajor() noexcept
    {
        return SHARP_RUNTIME_VERSION_MAJOR;
    }

    /**
     * @brief Returns the minor component of the Sharp Runtime release being compiled against.
     *
     * @return The Semantic Versioning minor component.
     */
    [[nodiscard]] constexpr int getVersionMinor() noexcept
    {
        return SHARP_RUNTIME_VERSION_MINOR;
    }

    /**
     * @brief Returns the patch component of the Sharp Runtime release being compiled against.
     *
     * @return The Semantic Versioning patch component.
     */
    [[nodiscard]] constexpr int getVersionPatch() noexcept
    {
        return SHARP_RUNTIME_VERSION_PATCH;
    }

    /**
     * @brief Returns the pre-release identifier of the release being compiled against.
     *
     * The leading '-' is not part of the value: the release 0.1.0-alpha.1 reports "alpha.1".
     *
     * @return The pre-release identifier, or an empty view on a final release.
     */
    [[nodiscard]] constexpr std::string_view getVersionPreRelease() noexcept
    {
        return SHARP_RUNTIME_VERSION_PRERELEASE;
    }

    /**
     * @brief Returns the complete release string of the release being compiled against.
     *
     * @return The version in Semantic Versioning spelling, e.g. "0.1.0-alpha.1"; no leading 'v'.
     */
    [[nodiscard]] constexpr std::string_view getVersionString() noexcept
    {
        return SHARP_RUNTIME_VERSION_STRING;
    }

    /**
     * @brief Reports whether this build is a pre-release (alpha, beta or release candidate).
     *
     * @return True when a pre-release identifier is present, false on a final release.
     */
    [[nodiscard]] constexpr bool isPreReleaseVersion() noexcept
    {
        return !getVersionPreRelease().empty();
    }
} // namespace SharpRuntime
